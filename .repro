# How every shipped SVG and page in this repository is drawn. Checked by
# lasermade-tools' repro-svg; $OUT is where the file must be written.
#
# kalimba.rs (Rust) draws the cut file and writes the SolidCraft design. It
# reads the rosette from the knotwork-soundholes checkout beside this one.
# The 3D viewer is built from the cut file by viewer.rs, which reads it with
# lasermade-tools' turn3d module, so it expects that checkout beside this one.

# --- the cut file ---
KalimbaSeptaBox.svg :: target/release/kalimba --out=$(dirname $OUT)

# --- the previews: display renderings of the cut files ---
previews/KalimbaSeptaBox.svg :: ../lasermade-tools/target/release/make-preview KalimbaSeptaBox.svg $OUT

# --- the pages ---
index.html :: ../lasermade-tools/target/release/md2html index.md $OUT
kalimba-3d.html :: target/release/viewer --out=$OUT

# --- the SolidCraft design, and the .sc and STEP files SolidCraft builds from it ---
solidcraft/kalimba-septa-box.solidcraft.json :: target/release/kalimba --no-write --solidcraft=$(dirname $OUT)
solidcraft/kalimba-septa-box.sc :: target/release/kalimba --no-write --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/kalimba-septa-box.solidcraft.json --save $OUT --quiet && ../lasermade-tools/target/release/sc-slim $OUT
step/kalimba-septa-box.step :: target/release/kalimba --no-write --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/kalimba-septa-box.solidcraft.json --out $OUT --quiet
