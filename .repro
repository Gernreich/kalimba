# How every shipped SVG and page in this repository is drawn. Checked by
# lasermade-tools' repro-svg; $OUT is where the file must be written.
#
# The 3D viewer is built from the cut files by viewer.rs (Rust; repro-svg
# builds it), which reads them with lasermade-tools' turn3d module, so it
# expects that checkout beside this one.

# --- the cut files: no command in this repository redraws them. They are
# the source the previews and the viewer are built from. ---
KalimbaSeptaBox.svg :: !

# --- the previews: display renderings of the cut files ---
previews/KalimbaSeptaBox.svg :: ../lasermade-tools/target/release/make-preview KalimbaSeptaBox.svg $OUT

# --- the pages ---
index.html :: ../lasermade-tools/target/release/md2html index.md $OUT
kalimba-3d.html :: target/release/viewer --out=$OUT

# --- the STEP files: the 3D view's parts as solids for a CAD program, one
# file per design, written from the page by lasermade-tools' step-export ---
step/kalimba-septa-box.step :: ../lasermade-tools/target/release/step-export kalimba-3d.html --name=kalimba --out=$(dirname $OUT)
